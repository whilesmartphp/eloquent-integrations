{
  "name": "whilesmart/eloquent-integrations",
  "description": "OAuth and third-party integrations package for Laravel applications",
  "type": "library",
  "license": "MIT",
  "package-version": "1.0.0",
  "authors": [
    {
      "name": "WhileSmart",
      "email": "engineering@whilesmart.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.4",
    "laravel/pint": "^1.13",
    "phpunit/phpunit": "^11.0",
    "phpmd/phpmd": "@stable",
    "phpstan/phpstan": "^2.1",
    "larastan/larastan": "^3.0",
    "squizlabs/php_codesniffer": "^4.0",
    "whilesmart/eloquent-schema-conformance": "^1.0"
  },
  "suggest": {
    "whilesmart/eloquent-client-credentials": "For reusable local credential and secret storage",
    "whilesmart/eloquent-workspaces": "For workspace-scoped integrations",
    "laravel/socialite": "For OAuth provider support"
  },
  "autoload": {
    "psr-4": {
      "Whilesmart\\Integrations\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Whilesmart\\Integrations\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Whilesmart\\Integrations\\IntegrationsServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "pint": [
      "./vendor/bin/pint --preset psr12"
    ],
    "pint:test": [
      "./vendor/bin/pint --preset psr12 --test"
    ],
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "build": "@php vendor/bin/testbench workbench:build --ansi",
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@build",
      "@php vendor/bin/testbench serve --ansi"
    ],
    "lint": [
      "@php vendor/bin/pint --preset psr12 --ansi"
    ],
    "phpmd": [
      "vendor/bin/phpmd src text phpmd.xml"
    ],
    "phpstan": "phpstan analyse src --memory-limit=2048M --level=5",
    "phpcs": "phpcbf src",
    "phpcs:test": "phpcs src",
    "test": "vendor/bin/testbench package:test --coverage"
  }
}
